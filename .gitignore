# ---------- Build outputs ----------
[Bb]in/
[Oo]bj/
*.dll
*.pdb
*.cache

# ---------- Visual Studio / Rider / VS Code ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# ---------- nopCommerce plugin-specific ----------
# Compiled plugin output that gets copied into the main app's Plugins folder
Plugins/**/bin/
Plugins/**/obj/

# Plugin's auto-generated description file (regenerated on build/install)
# Uncomment if you don't want to track it:
# plugin.json.bak

# Localization / resource cache (if plugin generates temp resx artifacts)
*.resx.orig

# Logs generated during local nopCommerce runs
Logs/
App_Data/Logs/

# nopCommerce local config/secrets that shouldn't be committed
App_Data/appsettings.json
App_Data/dataSettings.json

# ---------- NuGet ----------
*.nupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# ---------- Node / frontend assets (if plugin has a React/JS admin UI) ----------
node_modules/
dist/
wwwroot/scripts/dist/
npm-debug.log*
yarn-error.log*

# ---------- Test results ----------
TestResults/
*.trx
coverage/
*.coverage

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Environment / secrets ----------
.env
.env.local
appsettings.Development.json
appsettings.*.local.json